{% extends 'base.html.twig' %}

{% block title %}Lista de Livros{% endblock %}

{% block body %}
    <section class="container p-10 md:p-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center w-100 pb-4">
            <h1 class="fs-2xl pb-4">Lista de Livros</h1>
            <div class="d-flex flex-wrap gap-5">
                <a
                    href="{{ path('app_relatorio_livros_por_autor') }}"
                    data-turbo="false"
                    class="btn-solid theme-secondary d-inline-flex align-items-center gap-2"
                >
                    <i class="bi bi-download" aria-hidden="true"></i>
                    Baixar relatório por autor
                </a>
                <a href="{{ path('app_livro_new') }}" class="btn-solid theme-primary">Novo Livro <i class="bi bi-plus" aria-hidden="true"></i></a>
            </div>
        </div>

        <div class="border rounded-6 overflow-hidden shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="bg-black fg-white">ID</th>
                            <th scope="col" class="bg-black fg-white">Titulo</th>
                            <th scope="col" class="bg-black fg-white">Editora</th>
                            <th scope="col" class="bg-black fg-white">Edição</th>
                            <th scope="col" class="bg-black fg-white">Ano Publicação</th>
                            <th scope="col" class="bg-black fg-white">Preço</th>
                            <th scope="col" class="bg-black fg-white">Assuntos</th>
                            <th scope="col" class="bg-black fg-white">Autores</th>
                            <th scope="col" class="bg-black fg-white">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for livro in livros %}
                        <tr>
                            <td>{{ livro.id }}</td>
                            <td>{{ livro.titulo }}</td>
                            <td>{{ livro.editora }}</td>
                            <td>{{ livro.edicao }}</td>
                            <td>{{ livro.anoPublicacao }}</td>
                            <td>{{ 'R$ ' ~ livro.preco|number_format(2, ',', '.') }}</td>
                            <td>
                                {% for assunto in livro.assuntos %}
                                    <span class="badge bg-secondary">{{ assunto.descricao }}</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% for autor in livro.autores %}
                                    <span class="badge bg-secondary">{{ autor.nome }}</span>
                                {% endfor %}
                            </td>
                            <td>
                                <div class="actions-list d-flex justify-content-start align-items-center gap-4">
                                    <a
                                        href="{{ path('app_livro_show', {'id': livro.id}) }}"
                                        class="title-tooltip"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="bottom"
                                        data-bs-title="Visualizar"
                                    ><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a
                                        href="{{ path('app_livro_edit', {'id': livro.id}) }}"
                                        class="title-tooltip"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="bottom"
                                        data-bs-title="Editar"
                                    ><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                    <form method="post" action="{{ path('app_livro_delete', {'id': livro.id}) }}" onsubmit="return confirm('Deseja continuar a exclusão?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.id) }}">
                                        <button class="title-tooltip border-0 p-0" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Excluir" value="Excluir">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">Nenhum livro encontrado.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}
